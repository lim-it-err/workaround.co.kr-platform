# infra/home/.env 로 복사해서 쓴다. .env 는 커밋 금지(.gitignore).

# web 이 호스트(루프백)에 열리는 포트
HOME_WEB_PORT=8090

# Cloudflare Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰. --profile tunnel 일 때만 필요.
TUNNEL_TOKEN=

# --profile api(gateway) 일 때 필수(비우면 gateway 만 기동 실패, web 은 정상). 기본값 dev-key·저장소 기본 해시는 운영에서 기동 실패.
# 키 만들기:  openssl rand -hex 32
PLATFORM_API_KEY=
# Work Manager 비밀번호의 SHA-256(소문자 hex). 비밀번호를 정한 뒤:
#   printf '%s' '<비밀번호>' | shasum -a 256 | cut -d' ' -f1      (mac/Linux)
#   (PowerShell) (Get-FileHash -Algorithm SHA256 -InputStream ([IO.MemoryStream]::new([Text.Encoding]::UTF8.GetBytes('<비밀번호>')))).Hash.ToLower()
WORK_MANAGER_PASSWORD_SHA256=
OLLAMA_BASE_URL=
