PUBLIC_SITE_DOMAIN=workaround.co.kr
PUBLIC_SITE_ALIAS_DOMAIN=workaround.kr
PUBLIC_SITE_EMAIL=admin@workaround.co.kr
PUBLIC_SITE_LOCAL_PORT=8088
PLATFORM_API_KEY=replace-before-public-deploy
OLLAMA_BASE_URL=http://rtx5070-host:11434

# Primary public path: Cloudflare Pages + Tunnel. Keep the real token outside Git.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PAGES_PROJECT=workaround-co-kr
CLOUDFLARE_PAGES_BRANCH=main

# Configure this as the Pages project variable API_ORIGIN.
# The hostname must be mapped by Tunnel to http://gateway:8080.
PAGES_API_ORIGIN=https://api-origin.workaround.co.kr

# Legacy Caddy-only profile. Origin CA is not used by the Pages+Tunnel path.
# Keep the actual certificate/key files outside Git.
CLOUDFLARE_ORIGIN_CERT_CO_KR_PATH=./secrets/cloudflare-origin-co-kr.pem
CLOUDFLARE_ORIGIN_KEY_CO_KR_PATH=./secrets/cloudflare-origin-co-kr.key
CLOUDFLARE_ORIGIN_CERT_KR_PATH=./secrets/cloudflare-origin-kr.pem
CLOUDFLARE_ORIGIN_KEY_KR_PATH=./secrets/cloudflare-origin-kr.key

# Used only by update-cloudflare-dns.ps1. Never commit the token or zone IDs.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID_CO_KR=
CLOUDFLARE_ZONE_ID_KR=
PUBLIC_IPV4=
